{
  "name": "carewell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:demo": "node scripts/demo.js",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src server scripts *.js *.json *.md *.yaml .github",
    "check:db": "node scripts/check-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12"
  }
